# Mechanical enforcement of the boundary in docs/01-architecture.md.
#
# Invariant 1 ("the LLM never produces an authoritative financial number") is
# worth nothing as a convention. Contract 1 below is what makes it a build
# failure. Do not add an ignore_imports entry to it — if a module needs the
# LLM, it is on the wrong side of the boundary.

[importlinter]
# `main` is a module, not a package, so import-linter cannot take it as a root.
# It imports nothing but `routes`, so nothing is lost.
include_external_packages = True
root_packages =
    config
    routes
    orchestrator
    intent
    validation
    plan
    tools
    reconciliation
    runtime
    verification
    evidence
    provenance
    llm
    narrative

[importlinter:contract:1]
name = The deterministic and trust planes cannot reach the LLM
type = forbidden
source_modules =
    tools
    reconciliation
    runtime
    verification
    evidence
    provenance
    narrative
forbidden_modules =
    llm
    anthropic

[importlinter:contract:2]
name = Planes depend strictly downward
type = layers
# The trust plane sits BELOW tools, not above. A tool implements verify() and
# evidence() as part of its contract (docs/04-tool-contract.md), so it must be
# able to import the vocabulary those return. The trust plane reads tool
# *values* -- passed in as arguments -- never tool modules, which is what keeps
# the dependency pointing one way.
#
# verification / provenance / evidence were siblings until Phase 3, which is
# wrong in a way that only showed up once they had contents: the verifier
# re-evaluates a declared Formula (layer 4) and the provenance walker resolves
# an Evidence graph, so both must import `evidence`, and siblings may not
# import each other. Ordering them strictly is the honest shape -- `evidence`
# is a vocabulary, and the two things that consume it sit above it (D-28).
#
# orchestrator / intent / validation were siblings for the same reason, and
# break the same way now that they have contents: the planner reads an Intent
# and the validator checks one, so both must import `intent`, and siblings may
# not import each other. The honest order is the direction the pipeline runs --
# the orchestrator drives validation, validation judges a plan, and the intent
# parser is the only thing above the boundary that talks to a model.
#
# `plan` is a package for the same reason `evidence` is one: the orchestrator
# builds and runs a plan, the validator judges one, and neither may import the
# other -- so the type they both speak sits below both (D-44).
#
# `narrative` sits BELOW `llm`, which is the whole reason it is a package. It
# holds the deterministic template that renders verified metrics when the model
# is gone or ungrounded, and a fallback that could itself reach a model is not a
# fallback. It is also listed in contract 1: this is the one thing the system
# can always still do, and it must stay the one thing that needs nothing (D-50).
layers =
    routes
    orchestrator
    validation
    plan
    intent
    llm
    narrative
    tools
    verification
    provenance
    evidence
    reconciliation
    runtime
exhaustive = false

[importlinter:contract:3]
name = The agent plane reaches a vendor SDK only through llm/provider.py
type = forbidden
# `allow_indirect_imports` is the whole point of this contract, not a loophole
# in it. `llm.provider` is the one module permitted to import the SDK, and every
# module here is expected to reach it *through* that abstraction -- so a
# transitive check would forbid the design it exists to enforce. What is banned
# is a direct `import anthropic` in the agent plane, which is how a retry
# helper or a token count quietly becomes a second, unaudited model call site.
#
# Contract 1 stays transitive, and must: the deterministic and trust planes may
# not reach a model by any route at all.
allow_indirect_imports = True
source_modules =
    routes
    orchestrator
    intent
    validation
    plan
    tools
forbidden_modules =
    anthropic
