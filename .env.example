# Copy to .env. Never commit .env.
# docker-compose.yml supplies working defaults for local development, so this
# file only matters for deployed environments.

ENVIRONMENT=local

# Inside the compose network the host is `db`, not `localhost`.
DATABASE_URL=postgresql+asyncpg://razormind:razormind@db:5432/razormind

# Phase 6 onward. Absent means the LLM provider is disabled, which is a
# supported mode: the run still completes through the deterministic template.
LLM_ENABLED=false

# Which vendor. Named, not guessed from whichever key is present -- two keys in
# one environment would otherwise pick a model by accident.
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# The free path. Get a key at https://console.groq.com/keys, then set
# LLM_ENABLED=true and LLM_PROVIDER=groq.
# GROQ_API_KEY=
# llama-3.3-70b-versatile is the default. llama-3.1-8b-instant is faster and
# free too, and phrases the explanation badly often enough that the grounding
# gate throws the answer away and renders the template instead -- which is
# correct behaviour and a worse demo.
# GROQ_MODEL=llama-3.3-70b-versatile

# Below this the intent parser asks a clarifying question instead of running.
# INTENT_CONFIDENCE_THRESHOLD=0.75

INTENT_TIMEOUT_SECONDS=30
EXPLAIN_TIMEOUT_SECONDS=60

# Used ONLY by the seeding job, never by the request path.
# SUPABASE_SERVICE_ROLE_KEY=
