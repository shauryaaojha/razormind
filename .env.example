# Copy to .env. Never commit .env.
# docker-compose.yml supplies working defaults for local development, so this
# file only matters for deployed environments.

ENVIRONMENT=local

# Inside the compose network the host is `db`, not `localhost`.
DATABASE_URL=postgresql+asyncpg://razormind:razormind@db:5432/razormind

# Phase 6 onward. Absent means the LLM provider is disabled, which is a
# supported mode: the run still completes through the deterministic template.
LLM_ENABLED=false

# Which vendor. Named, not guessed from whichever key is present -- two keys in
# one environment would otherwise pick a model by accident.
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# The free path. Get a key at https://console.groq.com/keys, then set
# LLM_ENABLED=true and LLM_PROVIDER=groq.
# GROQ_API_KEY=
# openai/gpt-oss-120b is the default: the largest free model that supports a
# forced tool call. Groq's catalogue moves -- the Llama models were on it and
# are not any more -- so check your own key rather than this comment:
#   curl -H "Authorization: Bearer $GROQ_API_KEY" #        https://api.groq.com/openai/v1/models | grep '"id"'
# The `groq/compound*` entries are not candidates; they reject tool calling.
# GROQ_MODEL=openai/gpt-oss-120b
#
# NOTE on the free tier: every free model is capped at 8,000 tokens per minute.
# The intent call is ~1,000 tokens and fits. The explanation call carries the
# whole evidence brief -- ~8,700 tokens for a five-tool revenue diagnosis,
# because evidence ids and rendered rupee figures tokenise densely -- and does
# not fit at any output budget. So on the free tier the question is parsed by
# the model and the answer is rendered from the deterministic template. That is
# the designed degradation, not a misconfiguration, and the event log now says
# which one it was. Groq's dev tier, or an Anthropic key, runs both halves.

# Below this the intent parser asks a clarifying question instead of running.
# INTENT_CONFIDENCE_THRESHOLD=0.75

INTENT_TIMEOUT_SECONDS=30
EXPLAIN_TIMEOUT_SECONDS=60

# Used ONLY by the seeding job, never by the request path.
# SUPABASE_SERVICE_ROLE_KEY=
