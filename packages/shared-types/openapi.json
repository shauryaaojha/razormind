            "title": "Run Id",
            "type": "string"
          },
          "unmatched_bank_count": {
            "title": "Unmatched Bank Count",
            "type": "integer"
          },
          "unmatched_ledger_count": {
            "title": "Unmatched Ledger Count",
            "type": "integer"
          },
          "unresolved_exception_value_paise": {
            "title": "Unresolved Exception Value Paise",
            "type": "integer"
          }
        },
        "required": [
          "run_id",
          "period",
          "ledger_count",
          "bank_count",
          "matched_pairs_count",
          "matched_clean_count",
          "matched_with_exception_count",
