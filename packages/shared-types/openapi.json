  "info": {
    "description": "Agentic financial computation and reconciliation. The LLM decides what to compute; deterministic code decides what the number is.",
    "title": "RazorMind API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/agent/runs": {
      "post": {
        "description": "Reserve an execution, start it in the background, and return its id.\n\nThe row is inserted *before* returning, not by the background task: a\nclient that polls the id it was just handed must find something there, and\n\"202 Accepted, but ask again in a moment\" is an API that leaks a race.",
        "operationId": "start_run_api_v1_agent_runs_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-razormind-user",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Razormind-User"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunAccepted"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Start Run",
        "tags": [
          "agent"
        ]
      }
    },
